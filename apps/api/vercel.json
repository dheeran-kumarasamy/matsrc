{
  "version": 2,
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @matsrc/api build",

  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/pricing/cron/daily",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/pricing/cron/monthly",
      "schedule": "0 3 * * *"
    }
  ]
}
