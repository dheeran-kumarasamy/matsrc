{
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm --filter @matsrc/db db:generate && pnpm --filter @matsrc/web build",
  "installCommand": "cd ../.. && pnpm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/cleanup-idempotency",
      "schedule": "0 3 * * *"
    }
  ]
}
